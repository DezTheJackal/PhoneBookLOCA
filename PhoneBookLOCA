    # -------------------------------------------------------------- lookup

    def lookup(self, number, use_cache=True, enhanced=False, osint=False):
        """Main lookup function."""
        number = number.strip()
        print(f"\n{Y}[*]{W} Target: {number}")

        if use_cache:
            cached = self.db.cache_get(number)
            if cached:
                print(f"{G}[+]{W} Using cached data\n")
                self.display(cached)
                return cached

        print(f"{Y}[*]{W} Analyzing...\n")

        try:
            parsed = phonenumbers.parse(number, None)
        except phonenumbers.NumberParseException as e:
            print(f"{R}[!]{W} Could not parse number: {e}\n")
            return None

        if not phonenumbers.is_valid_number(parsed):
            print(f"{R}[!]{W} Invalid number\n")
            return None

        location = geocoder.description_for_number(parsed, "en") or "Unknown"
        carrier_name = carrier.name_for_number(parsed, "en") or "Unknown"
        tz = list(timezone.time_zones_for_number(parsed)) or ["Unknown"]

        results = {
            "number": number,
            "country_code": f"+{parsed.country_code}",
            "location": location,
            "carrier": carrier_name,
            "type": self.get_type(parsed),
            "timezone": tz,
            "valid": True,
            "timestamp": datetime.now().isoformat(),
        }

        if enhanced:
            results['enhanced'] = self.enhance(number, parsed, location)

        if osint:
            results['osint'] = self.osint_intel(number, parsed)

        self.db.cache_set(number, results)
        self.db.history_add(number, carrier_name, location)

        self.display(results)
        return results

    # ------------------------------------------------------------ enhance

    def enhance(self, number, parsed, location):
        """Enhanced geolocation, porting analysis, map link and history."""
        enhanced = {}

        country_code = str(parsed.country_code)
        national = str(parsed.national_number)
        # Area-code length varies by country (UK "20" vs US "415"), so try the
        # longest-to-shortest prefix and take the first match instead of
        # assuming a fixed 3-digit code.
        area_info = None
        for prefix_len in (4, 3, 2, 1):
            if len(national) >= prefix_len:
                area_info = self.db.get_area_code(country_code, national[:prefix_len])
                if area_info:
                    break

        precision = None
        if area_info:
            enhanced['coordinates'] = {
                'lat': area_info['lat'],
                'lon': area_info['lon'],
                'city': area_info['city'],
                'region': area_info['region'],
                'country': area_info['country'],
            }
            precision = 'area_code'
            enhanced['radius_km'] = 50

        if self.opencellid_key and enhanced.get('coordinates'):
            towers = self.get_opencellid(
                enhanced['coordinates']['lat'],
                enhanced['coordinates']['lon']
            )
            if towers:
                enhanced['cell_towers'] = len(towers)
                enhanced['nearest_tower_km'] = round(towers[0].get('_distance_km', 0), 1)
                precision = 'cell_tower'
                enhanced['radius_km'] = 5

        enhanced['precision'] = precision or 'country'
        enhanced['confidence'] = {
            'cell_tower': 90, 'area_code': 70, 'country': 30,
        }.get(enhanced['precision'], 30)

        if enhanced.get('coordinates'):
            lat, lon = enhanced['coordinates']['lat'], enhanced['coordinates']['lon']
            enhanced['map_link'] = f"https://www.google.com/maps?q={lat},{lon}"

        enhanced['porting'] = self.check_porting(number, parsed)
        enhanced['history'] = self.db.history_for(number)

        return enhanced

    def check_porting(self, number, parsed):
        """Porting likelihood with a simple weighted confidence score."""
        carrier_name = carrier.name_for_number(parsed, "en") or ""
        num_type = phonenumbers.number_type(parsed)

        indicators = []
        confidence = 0

        if num_type == phonenumbers.PhoneNumberType.VOIP:
            indicators.append("VoIP number")
            confidence += 45

        mvnos = ['mint', 'boost', 'cricket', 'metro', 'visible', 'google fi', 'ting']
        if any(m in carrier_name.lower() for m in mvnos):
            indicators.append("MVNO carrier detected")
            confidence += 35

        history = self.db.history_for(number)
        if history and history['carrier_changed']:
            indicators.append(
                f"Carrier changed historically: {', '.join(history['carriers_seen'])}"
            )
            confidence += 30

        confidence = min(confidence, 100)
        return {
            "likely_ported": confidence >= 40,
            "confidence": confidence,
            "indicators": indicators or ["No porting indicators found"],
        }

    def get_opencellid(self, lat, lon):
        """Query OpenCellID for nearby towers, sorted by distance."""
        if not self.opencellid_key:
            return []
        try:
            resp = requests.get(
                "https://opencellid.org/cell/getInArea",
                params={'key': self.opencellid_key, 'lat': lat, 'lon': lon,
                        'radius': 5000, 'format': 'json'},
                timeout=10,
            )
            resp.raise_for_status()
            cells = resp.json().get('cells', [])
            for cell in cells:
                try:
                    cell['_distance_km'] = haversine_km(lat, lon, float(cell['lat']), float(cell['lon']))
                except (KeyError, ValueError, TypeError):
                    cell['_distance_km'] = 0
            cells.sort(key=lambda c: c.get('_distance_km', 0))
            return cells[:5]
        except requests.RequestException as e:
            log.warning("OpenCellID request failed: %s", e)
            return []

    # -------------------------------------------------------------- osint

    def osint_intel(self, number, parsed):
        """Generate passive OSINT leads: dorks, lookup URLs, social checks, breach hints."""
        digits = "".join(ch for ch in number if ch.isdigit())
        national = str(parsed.national_number)

        intel = {
            'search_dorks': [
                f'"{number}"',
                f'"{national}" site:facebook.com',
                f'"{national}" site:linkedin.com',
                f'intext:"{number}" filetype:pdf',
            ],
            'lookup_services': [
                f"https://www.truecaller.com/search/{parsed.country_code}/{national}",
                f"https://sync.me/search/?number={digits}",
                f"https://www.whitepages.com/phone/{digits}",
            ],
            'breach_check': f"https://haveibeenpwned.com/  (search {number} manually - no public API for phone numbers)",
            'go_scraper': self._run_go_scraper(number),
        }
        return intel

    def _run_go_scraper(self, number):
        """Invoke the optional compiled Go scraper (scraper.go) if it is present on PATH
        or already built alongside this script. Cross-platform (scraper.exe on Windows)."""
        binary = "scraper.exe" if platform.system() == "Windows" else "scraper"
        found_on_path = shutil.which(binary)
        candidates = [APP_DIR / binary] + ([Path(found_on_path)] if found_on_path else [])
        for path in candidates:
            if path.exists():
                try:
                    proc = subprocess.run(
                        [str(path), number], capture_output=True, text=True, timeout=30
                    )
                    if proc.returncode == 0 and proc.stdout.strip():
                        return json.loads(proc.stdout)
                except (subprocess.SubprocessError, json.JSONDecodeError, OSError) as e:
                    log.warning("Go scraper failed: %s", e)
        return {
            "status": "not built",
            "note": "Build scraper.go for live web OSINT: go build -o scraper scraper.go "
                    "(scraper.exe on Windows)",
        }

    def get_type(self, parsed):
        types = {
            0: "Fixed Line", 1: "Mobile", 2: "Fixed/Mobile",
            3: "Toll Free", 4: "Premium", 5: "Shared Cost",
            6: "VoIP", 7: "Personal", 8: "Pager",
            9: "UAN", 10: "Voicemail",
        }
        return types.get(phonenumbers.number_type(parsed), "Unknown")

    def recommendations(self, r):
        """Investigative next-step suggestions based on what was found."""
        recs = []
        if r.get('type') == 'VoIP':
            recs.append("VoIP number - request subscriber info from the VoIP provider, not just the carrier")
        enh = r.get('enhanced', {})
        if enh.get('porting', {}).get('likely_ported'):
            recs.append("Likely ported - do not rely on area code alone for location; request porting history (LNP) from carrier")
        if not enh.get('coordinates'):
            recs.append("No area-code match on file - add coverage to data/area_codes.json or rely on carrier subpoena for location")
        if r.get('carrier') in self.carrier_contacts:
            recs.append(f"Legal contact on file for {r['carrier']} - see report for portal")
        if not recs:
            recs.append("No additional automated leads - proceed with standard legal process (CDR/subpoena) if required")
        return recs

