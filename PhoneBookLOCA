    # -------------------------------------------------------------- lookup

    def lookup(self, number, use_cache=True, enhanced=False, osint=False):
        """Main lookup function."""
        number = number.strip()
        print(f"\n{Y}[*]{W} Target: {number}")

        # OSINT/breach data is always fetched live, and a cached plain lookup must
        # not hide --geo / --osint sections that were never collected.
        if use_cache and not osint:
            cached = self.db.cache_get(number)
            if cached and (not enhanced or 'enhanced' in cached):
                print(f"{G}[+]{W} Using cached data\n")
                self.display(cached)
                return cached

        print(f"{Y}[*]{W} Analyzing...\n")

        try:
            parsed = phonenumbers.parse(number, None)
        except phonenumbers.NumberParseException as e:
            print(f"{R}[!]{W} Could not parse number: {e}\n")
            return None

        if not phonenumbers.is_valid_number(parsed):
            print(f"{R}[!]{W} Invalid number\n")
            return None

        location = geocoder.description_for_number(parsed, "en") or "Unknown"
        carrier_name = carrier.name_for_number(parsed, "en") or "Unknown"
        tz = list(timezone.time_zones_for_number(parsed)) or ["Unknown"]

        results = {
            "number": number,
            "country_code": f"+{parsed.country_code}",
            "location": location,
            "carrier": carrier_name,
            "type": self.get_type(parsed),
            "timezone": tz,
            "valid": True,
            "timestamp": datetime.now().isoformat(),
        }

        if enhanced:
            results['enhanced'] = self.enhance(number, parsed, location)

        if osint:
            results['osint'] = self.osint_intel(number, parsed)

        self.db.cache_set(number, results)
        self.db.history_add(number, carrier_name, location)

        self.display(results)
        return results

    # ------------------------------------------------------------ enhance

    def enhance(self, number, parsed, location):
        """Enhanced geolocation, porting analysis, map link and history."""
        enhanced = {}

        country_code = str(parsed.country_code)
        national = str(parsed.national_number)
        # Area-code length varies by country (UK "20" vs US "415"), so try the
        # longest-to-shortest prefix and take the first match instead of
        # assuming a fixed 3-digit code.
        area_info = None
        for prefix_len in (4, 3, 2, 1):
            if len(national) >= prefix_len:
                area_info = self.db.get_area_code(country_code, national[:prefix_len])
                if area_info:
                    break

        precision = None
        if area_info:
            enhanced['coordinates'] = {
                'lat': area_info['lat'],
                'lon': area_info['lon'],
                'city': area_info['city'],
                'region': area_info['region'],
                'country': area_info['country'],
            }
            precision = 'area_code'
            enhanced['radius_km'] = 50

        if self.opencellid_key and enhanced.get('coordinates'):
            towers = self.get_opencellid(
                enhanced['coordinates']['lat'],
                enhanced['coordinates']['lon']
            )
            if towers:
                enhanced['cell_towers'] = len(towers)
                enhanced['nearest_tower_km'] = round(towers[0].get('_distance_km', 0), 1)
                precision = 'cell_tower'
                enhanced['radius_km'] = 5

        enhanced['precision'] = precision or 'country'
        enhanced['confidence'] = {
            'cell_tower': 90, 'area_code': 70, 'country': 30,
        }.get(enhanced['precision'], 30)

        if enhanced.get('coordinates'):
            lat, lon = enhanced['coordinates']['lat'], enhanced['coordinates']['lon']
            enhanced['map_link'] = f"https://www.google.com/maps?q={lat},{lon}"

        enhanced['porting'] = self.check_porting(number, parsed)
        enhanced['history'] = self.db.history_for(number)

        return enhanced

    def check_porting(self, number, parsed):
        """Porting likelihood with a simple weighted confidence score."""
        carrier_name = carrier.name_for_number(parsed, "en") or ""
        num_type = phonenumbers.number_type(parsed)

        indicators = []
        confidence = 0

        if num_type == phonenumbers.PhoneNumberType.VOIP:
            indicators.append("VoIP number")
            confidence += 45

        mvnos = ['mint', 'boost', 'cricket', 'metro', 'visible', 'google fi', 'ting']
        if any(m in carrier_name.lower() for m in mvnos):
            indicators.append("MVNO carrier detected")
            confidence += 35

        history = self.db.history_for(number)
        if history and history['carrier_changed']:
            indicators.append(
                f"Carrier changed historically: {', '.join(history['carriers_seen'])}"
            )
            confidence += 30

        confidence = min(confidence, 100)
        return {
            "likely_ported": confidence >= 40,
            "confidence": confidence,
            "indicators": indicators or ["No porting indicators found"],
        }

    def get_opencellid(self, lat, lon):
        """Query OpenCellID for towers in a ~5 km box around a point.

        Uses the documented cell/getInArea endpoint (BBOX = latmin,lonmin,latmax,lonmax).
        Each returned cell costs 1 credit of the free 1,000/day quota, so at most 5 are
        requested. OpenCellID only serves this endpoint to whitelisted keys (free for apps
        that contribute data); other keys get HTTP 403 and this simply returns [].
        """
        if not self.opencellid_key:
            return []
        d_lat = 0.045                                            # ~5 km
        d_lon = d_lat / max(math.cos(math.radians(lat)), 0.2)
        bbox = f"{lat - d_lat:.5f},{lon - d_lon:.5f},{lat + d_lat:.5f},{lon + d_lon:.5f}"
        try:
            resp = requests.get(
                "https://opencellid.org/cell/getInArea",
                params={'key': self.opencellid_key, 'BBOX': bbox, 'limit': 5, 'format': 'json'},
                timeout=10,
            )
            if resp.status_code == 403:
                log.warning("OpenCellID: key is not whitelisted for cell/getInArea (HTTP 403) - tower data skipped")
                return []
            if resp.status_code == 429:
                log.warning("OpenCellID: daily limit reached (HTTP 429) - tower data skipped")
                return []
            resp.raise_for_status()
            cells = resp.json().get('cells', [])
        except (requests.RequestException, ValueError) as e:
            log.warning("OpenCellID request failed: %s", scrub_secrets(e))
            return []
        for cell in cells:
            try:
                cell['_distance_km'] = haversine_km(lat, lon, float(cell['lat']), float(cell['lon']))
            except (KeyError, ValueError, TypeError):
                cell['_distance_km'] = 0
        cells.sort(key=lambda c: c.get('_distance_km', 0))
        return cells[:5]

    # -------------------------------------------------------------- osint

    def osint_intel(self, number, parsed):
        """Passive OSINT leads: dorks + clickable search links, lookup services,
        messaging-app checks and a data-breach check (see check_breaches)."""
        e164 = phonenumbers.format_number(parsed, phonenumbers.PhoneNumberFormat.E164)
        intl = phonenumbers.format_number(parsed, phonenumbers.PhoneNumberFormat.INTERNATIONAL)
        local = phonenumbers.format_number(parsed, phonenumbers.PhoneNumberFormat.NATIONAL)
        digits = e164.lstrip('+')
        national = str(parsed.national_number)
        region = (phonenumbers.region_code_for_number(parsed) or '').lower()

        # Pages usually print a number in local OR international style, so search both.
        variants = [e164, intl, local]
        either = ' OR '.join(f'"{v}"' for v in dict.fromkeys(variants))
        dorks = [
            either,
            f'({either}) site:facebook.com',
            f'({either}) site:linkedin.com',
            f'({either}) filetype:pdf',
        ]
        search_links = [
            'https://www.google.com/search?q=' + quote_plus(d) for d in dorks
        ]

        lookup_services = []
        if region:
            # Truecaller's web search uses the ISO region (e.g. za, us), not the calling code.
            lookup_services.append(f"https://www.truecaller.com/search/{region}/{national}")
        lookup_services.append(f"https://sync.me/search/?number={digits}")
        if parsed.country_code == 1 and len(national) == 10:
            lookup_services.append(
                f"https://www.whitepages.com/phone/1-{national[:3]}-{national[3:6]}-{national[6:]}")

        # Messaging apps: each link opens the app's own "is this number registered" flow.
        messaging = {
            'whatsapp': f"https://wa.me/{digits}",
            'telegram': f"https://t.me/+{digits}",
            'signal': f"https://signal.me/#p/{quote(e164)}",
        }

        breach = self.check_breaches(parsed)

        # Free open-source tools to run locally for deeper phone OSINT.
        open_source_tools = [
            {'name': 'PhoneInfoga', 'url': 'https://github.com/sundowndev/phoneinfoga',
             'note': f'phoneinfoga scan -n {e164}'},
            {'name': 'Ignorant', 'url': 'https://github.com/megadose/ignorant',
             'note': 'checks which sites a phone number is registered on'},
        ]

        return {
            'search_dorks': dorks,
            'search_links': search_links,
            'lookup_services': lookup_services,
            'messaging_checks': messaging,
            'open_source_tools': open_source_tools,
            'breach_check': breach['manual_links'][0]['url'],
            'breach': breach,
            'go_scraper': self._run_go_scraper(number),
        }

    # ------------------------------------------------------- breach check

    def check_breaches(self, parsed):
        """Check whether the number appears in known data breaches.

        Works with NO API keys: breach files you already hold are searched
        locally (see _breach_local). Automated online lookups additionally run
        for each service whose key is set (HIBP_API_KEY, LEAKCHECK_API_KEY);
        services without a key are reported as 'skipped'. Manual search links
        are always provided.
        If any breach is found, JSON + HTML report files are written to
        ~/.phonebookloca/reports/breach/.
        """
        e164 = phonenumbers.format_number(parsed, phonenumbers.PhoneNumberFormat.E164)
        digits = e164.lstrip('+')

        # Free manual lookups only (no paid platforms). HIBP's site is free to search
        # but only indexes phone numbers for a few breaches (e.g. Facebook 2021).
        manual_links = [
            {'name': 'Have I Been Pwned', 'url': 'https://haveibeenpwned.com/',
             'note': f'Free. Paste {e164} into the search box (phone coverage is limited, e.g. the 2021 Facebook leak)'},
            {'name': 'Max Intel Phone Lookup', 'url': 'https://maxintel.org/phone.html',
             'note': f'Free, no signup. Enter {e164} to open 20+ reverse-lookup and spam-report sources'},
        ]

        sources = [
            self._breach_local(parsed),
            self._breach_hibp(digits),
            self._breach_leakcheck(digits),
        ]
        breaches = [b for src in sources for b in src.get('breaches', [])]

        result = {
            'checked_at': datetime.now().isoformat(),
            'number': e164,
            'sources': [{k: v for k, v in src.items() if k != 'breaches'} for src in sources],
            'breached': bool(breaches),
            'breach_count': len(breaches),
            'breaches': breaches,
            'manual_links': manual_links,
            'report_files': [],
        }
        if breaches:
            result['report_files'] = self._write_breach_reports(result)
        return result

    # Breach-file types searched by the offline (no-API) check.
    BREACH_SUFFIXES = {'.csv', '.tsv', '.txt', '.json', '.jsonl', '.sql', '.log'}
    BREACH_MAX_FILES = 500
    BREACH_MAX_HITS_PER_FILE = 25
    BREACH_MAX_HITS_TOTAL = 100

    def breach_data_dir(self):
        """Folder searched by the offline breach check (override: PHONEBOOKLOCA_BREACH_DIR)."""
        env = os.getenv('PHONEBOOKLOCA_BREACH_DIR')
        return Path(env).expanduser() if env else self.cache_dir / "breach_data"

    @staticmethod
    def _number_forms(parsed):
        """Every digit-only form a number is commonly stored as in leaked data."""
        e164 = phonenumbers.format_number(parsed, phonenumbers.PhoneNumberFormat.E164).lstrip('+')
        national_fmt = re.sub(r'\D', '', phonenumbers.format_number(
            parsed, phonenumbers.PhoneNumberFormat.NATIONAL))
        nsn = str(parsed.national_number)
        return {e164, '00' + e164, national_fmt, nsn, '0' + nsn}

    def _breach_local(self, parsed):
        """Search breach files on disk for the number. No API, no network.

        Drop leaked/breach datasets (.csv .tsv .txt .json .jsonl .sql .log, or
        gzip-compressed versions ending in .gz) into the breach data folder.
        Each field of each line is reduced to its digits and compared with every
        common storage form of the number, so '+27 82 123 4567', '082 123 4567'
        and '27821234567' all match - but a longer number that merely contains
        these digits does not. Only the file name, line number and CSV column
        NAMES are recorded; the matching line itself is never stored.
        """
        name = 'Local breach files'
        folder = self.breach_data_dir()
        try:
            folder.mkdir(parents=True, exist_ok=True)   # so the user can see where to drop files
        except OSError as e:
            return {'service': name, 'status': 'error', 'detail': f'cannot use {folder}: {e}'}

        files = []
        try:
            for f in sorted(folder.rglob('*')):
                base = f.name[:-3] if f.name.lower().endswith('.gz') else f.name
                if (f.is_file() and not f.name.startswith('.')
                        and Path(base).suffix.lower() in self.BREACH_SUFFIXES):
                    files.append(f)
                    if len(files) >= self.BREACH_MAX_FILES:
                        break
        except OSError as e:
            return {'service': name, 'status': 'error', 'detail': str(e)}

        if not files:
            return {'service': name, 'status': 'skipped',
                    'detail': f'no breach files found - drop datasets in {folder}'}

        forms = self._number_forms(parsed)
        field_split = re.compile(r'[,;\t|"\':=<>\[\]{}]')
        hits, truncated = [], False

        for f in files:
            opener = gzip.open if f.name.lower().endswith('.gz') else open
            base = f.name[:-3] if f.name.lower().endswith('.gz') else f.name
            delimited = Path(base).suffix.lower() in ('.csv', '.tsv')
            columns, file_hits = [], 0
            try:
                with opener(f, 'rt', encoding='utf-8', errors='ignore') as fh:
                    for lineno, line in enumerate(fh, 1):
                        if lineno == 1 and delimited and not re.search(r'\d{7,}', line):
                            columns = [c.strip(' "\'\r\n')[:20] for c in re.split(r'[,;\t|]', line)][:15]
                            columns = [c for c in columns if c]
                        if not any(ch.isdigit() for ch in line):
                            continue
                        for field in field_split.split(line):
                            if re.sub(r'\D', '', field) in forms:
                                hits.append({
                                    'source': 'Local breach files',
                                    'name': f"{f.relative_to(folder)} (line {lineno})",
                                    'breach_date': None,
                                    'domain': None,
                                    'data_classes': columns,
                                    'pwn_count': None,
                                })
                                file_hits += 1
                                break
                        if file_hits >= self.BREACH_MAX_HITS_PER_FILE:
                            truncated = True
                            break
            except (OSError, EOFError, gzip.BadGzipFile) as e:
                log.warning("Could not read %s: %s", f, e)
            if len(hits) >= self.BREACH_MAX_HITS_TOTAL:
                truncated = True
                break

        if hits:
            note = ' (list truncated)' if truncated else ''
            return {'service': name, 'status': 'breached',
                    'detail': f'{len(hits)} match(es) in {len(files)} file(s){note}', 'breaches': hits}
        return {'service': name, 'status': 'clean', 'detail': f'{len(files)} file(s) scanned, no matches'}

    @staticmethod
    def _skipped(name, env_var):
        return {'service': name, 'status': 'skipped',
                'detail': f'set {env_var} to enable automated checks'}

    def _breach_hibp(self, digits):
        """Have I Been Pwned: GET /api/v3/breachedaccount/{E.164 digits}."""
        key = os.getenv('HIBP_API_KEY')
        if not key:
            return self._skipped('Have I Been Pwned', 'HIBP_API_KEY')
        try:
            resp = requests.get(
                f"https://haveibeenpwned.com/api/v3/breachedaccount/{digits}",
                params={'truncateResponse': 'false'},
                headers={'hibp-api-key': key,
                         'user-agent': f'PhoneBookLOCA/{VERSION}'},
                timeout=15,
            )
        except requests.RequestException as e:
            log.warning("HIBP request failed: %s", e)
            return {'service': 'Have I Been Pwned', 'status': 'error', 'detail': str(e)}

        if resp.status_code == 404:
            return {'service': 'Have I Been Pwned', 'status': 'clean', 'detail': 'no breaches found'}
        if resp.status_code == 200:
            try:
                data = resp.json()
            except ValueError:
                return {'service': 'Have I Been Pwned', 'status': 'error', 'detail': 'invalid JSON response'}
            breaches = [{
                'source': 'Have I Been Pwned',
                'name': b.get('Title') or b.get('Name'),
                'breach_date': b.get('BreachDate'),
                'domain': b.get('Domain'),
                'data_classes': b.get('DataClasses', []),
                'pwn_count': b.get('PwnCount'),
            } for b in data]
            return {'service': 'Have I Been Pwned', 'status': 'breached',
                    'detail': f'{len(breaches)} breach(es)', 'breaches': breaches}
        detail = {401: 'invalid or missing API key', 429: 'rate limited - retry shortly'}.get(
            resp.status_code, f'HTTP {resp.status_code}')
        return {'service': 'Have I Been Pwned', 'status': 'error', 'detail': detail}

    def _breach_leakcheck(self, digits):
        """LeakCheck Pro API v2: GET /api/v2/query/{digits}?type=phone.

        Only the breach source and the NAMES of exposed fields are kept - raw
        values (which can include passwords) are never stored or written to disk.
        """
        key = os.getenv('LEAKCHECK_API_KEY')
        if not key:
            return self._skipped('LeakCheck', 'LEAKCHECK_API_KEY')
        try:
            resp = requests.get(
                f"https://leakcheck.io/api/v2/query/{digits}",
                params={'type': 'phone'},
                headers={'X-API-Key': key, 'Accept': 'application/json'},
                timeout=15,
            )
        except requests.RequestException as e:
            log.warning("LeakCheck request failed: %s", e)
            return {'service': 'LeakCheck', 'status': 'error', 'detail': str(e)}

        if resp.status_code != 200:
            detail = {400: 'invalid API key or query', 401: 'missing API key',
                      422: 'could not determine search type', 429: 'rate limited - retry shortly'}.get(
                resp.status_code, f'HTTP {resp.status_code}')
            return {'service': 'LeakCheck', 'status': 'error', 'detail': detail}
        try:
            data = resp.json()
        except ValueError:
            return {'service': 'LeakCheck', 'status': 'error', 'detail': 'invalid JSON response'}

        if not data.get('success', False):
            return {'service': 'LeakCheck', 'status': 'error',
                    'detail': str(data.get('error', 'request failed'))}
        rows = data.get('result') or []
        if not rows:
            return {'service': 'LeakCheck', 'status': 'clean', 'detail': 'no breaches found'}

        breaches = []
        for row in rows:
            src = row.get('source') or {}
            breaches.append({
                'source': 'LeakCheck',
                'name': src.get('name') or 'Unknown source',
                'breach_date': src.get('breach_date'),
                'domain': None,
                'data_classes': sorted(k for k in row if k != 'source'),
                'pwn_count': None,
            })
        return {'service': 'LeakCheck', 'status': 'breached',
                'detail': f'{len(breaches)} record(s)', 'breaches': breaches}

    def _write_breach_reports(self, result):
        """Write the breach findings to their own JSON + HTML files."""
        out_dir = self.cache_dir / "reports" / "breach"
        try:
            out_dir.mkdir(parents=True, exist_ok=True)
        except OSError as e:
            log.warning("Could not create breach report dir: %s", e)
            return []

        stem = out_dir / f"BREACH_{result['number'].lstrip('+')}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        files = []

        try:
            jpath = stem.with_suffix('.json')
            with open(jpath, 'w', encoding='utf-8') as f:
                json.dump(result, f, indent=2)
            files.append(str(jpath))
        except OSError as e:
            log.warning("Could not write breach JSON: %s", e)

        esc = html.escape
        rows = "".join(
            "<tr><td>{}</td><td>{}</td><td>{}</td><td>{}</td></tr>".format(
                esc(str(b.get('source') or '')), esc(str(b.get('name') or '')),
                esc(str(b.get('breach_date') or 'n/a')),
                esc(', '.join(b.get('data_classes') or []) or 'n/a'))
            for b in result['breaches'])
        links = "".join(
            '<li><a href="{}">{}</a> - {}</li>'.format(esc(l['url'], quote=True), esc(l['name']), esc(l['note']))
            for l in result['manual_links'])
        page = f"""<!DOCTYPE html><html><head><meta charset="utf-8">
<title>PhoneBookLOCA Breach Report - {esc(result['number'])}</title>
<style>body{{font-family:'Courier New',monospace;background:#0a0014;color:#7ef9ff;padding:2em}}
h1{{color:#ff00e6}}h2{{color:#00f0ff}}table{{border-collapse:collapse;width:100%}}
th,td{{border:1px solid #00f0ff55;padding:6px 12px;text-align:left}}th{{color:#ff6bf0}}
a{{color:#ff6bf0}}.warn{{color:#ffd166}}</style></head><body>
<h1>PhoneBookLOCA :: Data Breach Report</h1>
<p>Number: <b>{esc(result['number'])}</b><br>Checked: {esc(result['checked_at'])}<br>
Breach records found: <b>{result['breach_count']}</b></p>
<table><tr><th>Service</th><th>Breach / file</th><th>Date</th><th>Data exposed (column names)</th></tr>{rows}</table>
<h2>Verify manually</h2><ul>{links}</ul>
<p class="warn">Presence in a breach shows the number appeared in leaked data; it does not by itself
identify or attribute the number to a person. Verify before relying on it.</p>
</body></html>"""
        try:
            hpath = stem.with_suffix('.html')
            with open(hpath, 'w', encoding='utf-8') as f:
                f.write(page)
            files.append(str(hpath))
        except OSError as e:
            log.warning("Could not write breach HTML: %s", e)
        return files

    def _run_go_scraper(self, number):
        """Invoke the optional compiled Go scraper (scraper.go) if it is present on PATH
        or already built alongside this script. Cross-platform (scraper.exe on Windows)."""
        binary = "scraper.exe" if platform.system() == "Windows" else "scraper"
        found_on_path = shutil.which(binary)
        candidates = [APP_DIR / binary] + ([Path(found_on_path)] if found_on_path else [])
        for path in candidates:
            if path.exists():
                try:
                    proc = subprocess.run(
                        [str(path), number], capture_output=True, text=True, timeout=30
                    )
                    if proc.returncode == 0 and proc.stdout.strip():
                        return json.loads(proc.stdout)
                except (subprocess.SubprocessError, json.JSONDecodeError, OSError) as e:
                    log.warning("Go scraper failed: %s", e)
        return {
            "status": "not built",
            "note": "Build scraper.go for live web OSINT: go build -o scraper scraper.go "
                    "(scraper.exe on Windows)",
        }

    def get_type(self, parsed):
        types = {
            0: "Fixed Line", 1: "Mobile", 2: "Fixed/Mobile",
            3: "Toll Free", 4: "Premium", 5: "Shared Cost",
            6: "VoIP", 7: "Personal", 8: "Pager",
            9: "UAN", 10: "Voicemail",
        }
        return types.get(phonenumbers.number_type(parsed), "Unknown")

    def recommendations(self, r):
        """Investigative next-step suggestions based on what was found."""
        recs = []
        if r.get('type') == 'VoIP':
            recs.append("VoIP number - request subscriber info from the VoIP provider, not just the carrier")
        enh = r.get('enhanced', {})
        if enh.get('porting', {}).get('likely_ported'):
            recs.append("Likely ported - do not rely on area code alone for location; request porting history (LNP) from carrier")
        if not enh.get('coordinates'):
            recs.append("No area-code match on file - add coverage to data/area_codes.json or rely on carrier subpoena for location")
        breach = (r.get('osint') or {}).get('breach') or {}
        if breach.get('breached'):
            recs.append(f"Number appears in {breach['breach_count']} breach record(s) - review the breach report and verify before relying on it")
        if r.get('carrier') in self.carrier_contacts:
            recs.append(f"Legal contact on file for {r['carrier']} - see report for portal")
        if not recs:
            recs.append("No additional automated leads - proceed with standard legal process (CDR/subpoena) if required")
        return recs

