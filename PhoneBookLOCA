    def batch(self, numbers, output=None):
        """Batch analysis with clustering, VoIP ratio and a 0-100 risk score."""
        print(f"\n{Y}[*]{W} Batch Analysis: {len(numbers)} numbers\n")

        results, carriers, locations, voip_count = [], [], [], 0
        for num in numbers:
            r = self.lookup(num, use_cache=True, enhanced=False)
            if r:
                results.append(r)
                carriers.append(r['carrier'])
                locations.append(r['location'])
                if r['type'] == 'VoIP':
                    voip_count += 1

        carrier_counts = Counter(carriers)
        loc_counts = Counter(locations)
        n = len(results) or 1

        patterns = []
        risk_score = 0

        same_carrier_pct = (carrier_counts.most_common(1)[0][1] / n * 100) if carrier_counts else 0
        if len(carrier_counts) == 1 and len(results) > 5:
            patterns.append("All numbers on same carrier - possible bulk purchase")
            risk_score += 30

        clustering_score = (1 - (len(loc_counts) / n)) if n else 0
        if len(loc_counts) <= 2 and len(results) > 5:
            patterns.append(f"High geographic clustering: {len(results)} numbers in {len(loc_counts)} locations")
            risk_score += 30

        voip_pct = (voip_count / n * 100) if results else 0
        if voip_pct > 50:
            patterns.append(f"High VoIP usage: {voip_count}/{len(results)} numbers are VoIP")
            risk_score += 25

        risk_score = min(risk_score, 100)
        risk_level = "High" if risk_score >= 60 else "Medium" if risk_score >= 30 else "Low"

        print(f"\n{C}[*]{W} Pattern Analysis:\n")
        for p in patterns:
            print(f"{Y}[!]{W} {p}")

        print(f"\n{G}[+]{W} Summary:")
        print(f"  Valid: {len(results)}/{len(numbers)}")
        print(f"  Unique Carriers: {len(carrier_counts)}")
        print(f"  Unique Locations: {len(loc_counts)}")
        print(f"  Risk Level: {risk_level} ({risk_score}/100)")
        print()

        report = {
            "generated": datetime.now().isoformat(),
            "total_numbers": len(numbers),
            "valid_numbers": len(results),
            "geographic_clustering": {
                "unique_locations": len(loc_counts),
                "most_common": loc_counts.most_common(5),
                "clustering_score": round(clustering_score, 2),
            },
            "carrier_patterns": {
                "unique_carriers": len(carrier_counts),
                "same_carrier_percentage": round(same_carrier_pct, 1),
            },
            "voip_percentage": round(voip_pct, 1),
            "risk_assessment": {
                "risk_score": risk_score,
                "risk_level": risk_level,
                "patterns_detected": len(patterns),
            },
            "suspicious_patterns": patterns,
            "numbers": results,
        }

        out_path = Path(output) if output else Path.cwd() / f"batch_analysis_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
        try:
            with open(out_path, 'w', encoding='utf-8') as f:
                json.dump(report, f, indent=2)
            print(f"{G}[+]{W} Batch report saved: {out_path}\n")
        except OSError as e:
            print(f"{R}[!]{W} Could not save report: {e}\n")

        return report

    # ------------------------------------------------------------------ AI

    AI_SYSTEM = (
        "You are an assistant for authorised OSINT and law-enforcement analysts. "
        "You only see NON-IDENTIFYING metadata from a public-data phone lookup; the phone number, "
        "case details and file names are deliberately withheld. Be factual and cautious: never guess "
        "who owns a number, never invent data, and separate what the data shows from what it cannot "
        "show. Note reliability limits where relevant (area-code geolocation is coarse and wrong for "
        "ported numbers; a breach hit means the number appeared in leaked data, not who uses it). "
        "End with 2-4 concrete, lawful next steps (for example a carrier legal-process request, "
        "verifying breach records, corroborating sources). Plain text only, no markdown tables."
    )
    AI_USER_AGENT = f"PhoneBookLOCA/{VERSION}"

    def ai_providers(self):
        """Configured free AI providers, preferred one first."""
        have = {'gemini': bool(os.getenv('GEMINI_API_KEY')), 'groq': bool(os.getenv('GROQ_API_KEY'))}
        pref = (os.getenv('AI_PROVIDER') or '').strip().lower()
        order = []
        for name in ([pref] if pref in have else []) + ['gemini', 'groq']:
            if have.get(name) and name not in order:
                order.append(name)
        return order

    @staticmethod
    def ai_facts(result):
        """The ONLY data about a lookup that is ever sent to an AI provider.
        Never included: the phone number, case number, officer, agency, file names."""
        enh = result.get('enhanced') or {}
        port = enh.get('porting') or {}
        hist = enh.get('history') or {}
        coords = enh.get('coordinates') or {}
        breach = (result.get('osint') or {}).get('breach') or {}
        facts = {
            'country_or_region': result.get('location'),
            'country_calling_code': result.get('country_code'),
            'line_type': result.get('type'),
            'carrier': result.get('carrier'),
            'timezones': result.get('timezone'),
        }
        if enh:
            facts['geolocation'] = {
                'precision': enh.get('precision'),
                'confidence_pct': enh.get('confidence'),
                'area_code_match': (f"{coords.get('city')}, {coords.get('region')}" if coords else None),
                'radius_km': enh.get('radius_km'),
            }
        if port:
            facts['porting'] = {'likely_ported': port.get('likely_ported'),
                                'confidence_pct': port.get('confidence'),
                                'indicators': port.get('indicators')}
        if hist:
            facts['lookup_history'] = {'times_looked_up': hist.get('total_lookups'),
                                       'carrier_changed': hist.get('carrier_changed')}
        if breach:
            facts['breach_check'] = {
                'number_found_in_breach_data': breach.get('breached'),
                'records_found': breach.get('breach_count'),
                'exposed_field_names': sorted({c for b in breach.get('breaches', [])
                                               for c in (b.get('data_classes') or [])}),
                'sources_checked': [{'service': s.get('service'), 'status': s.get('status')}
                                    for s in breach.get('sources', [])
                                    if s.get('status') != 'skipped'],
            }
        return facts

    @staticmethod
    def ai_facts_from_rows(rows, case_type, priority):
        """Non-identifying facts for a whole LE list: items are only numbered (no numbers, no case ids)."""
        ok = [r for r in rows if r.get('status') == 'ok']
        return {
            'case_type': case_type, 'priority': priority,
            'totals': {
                'numbers': len(rows), 'processed_ok': len(ok),
                'invalid_or_failed': len(rows) - len(ok),
                'found_in_breach_data': sum(1 for r in ok if str(r.get('breach', '')).startswith('BREACHED')),
                'likely_ported': sum(1 for r in ok if str(r.get('porting', '')).startswith('likely')),
                'carriers': dict(Counter(r.get('carrier') for r in ok)),
                'line_types': dict(Counter(r.get('line_type') for r in ok)),
                'countries': dict(Counter(r.get('location') for r in ok)),
            },
            'items': [{'item': r['item'], 'status': r.get('status'), 'carrier': r.get('carrier'),
                       'country': r.get('location'), 'line_type': r.get('line_type'),
                       'porting': r.get('porting'), 'geo_precision': r.get('geo_precision'),
                       'breach_result': r.get('breach')} for r in rows],
        }

    def _ai_http_error(self, name, resp):
        try:
            err = resp.json().get('error') or {}
            detail = err.get('message') if isinstance(err, dict) else str(err)
        except (ValueError, AttributeError):
            detail = ''
        hints = {400: 'request or key rejected', 401: 'key rejected - re-run setup_apis.py',
                 403: 'access denied (key invalid, or API not enabled for it)',
                 404: 'model not found - remove GEMINI_MODEL / GROQ_MODEL or re-run setup_apis.py',
                 429: 'free-tier rate limit reached - wait a minute and retry'}
        msg = hints.get(resp.status_code, f'HTTP {resp.status_code}')
        if detail and resp.status_code != 429:
            msg += f" ({scrub_secrets(detail)[:120]})"
        return RuntimeError(f"{name}: {msg}")

    def _ai_gemini(self, system, user):
        key = os.getenv('GEMINI_API_KEY')
        headers = {'x-goog-api-key': key, 'Content-Type': 'application/json',
                   'User-Agent': self.AI_USER_AGENT}
        base = "https://generativelanguage.googleapis.com/v1beta"
        model = os.getenv('GEMINI_MODEL')
        try:
            if not model:
                r = requests.get(f"{base}/models", headers=headers, params={'pageSize': 200}, timeout=15)
                if r.status_code != 200:
                    raise self._ai_http_error('gemini', r)
                model = pick_gemini_model(r.json().get('models', [])) or 'gemini-flash-latest'
            payload = {
                'systemInstruction': {'parts': [{'text': system}]},
                'contents': [{'role': 'user', 'parts': [{'text': user}]}],
                'generationConfig': {'temperature': 0.2, 'maxOutputTokens': 2048},
            }
            r = requests.post(f"{base}/models/{model}:generateContent", headers=headers,
                              json=payload, timeout=60)
        except (requests.RequestException, ValueError) as e:
            raise RuntimeError(f"gemini: network/response error ({scrub_secrets(e)[:100]})")
        if r.status_code != 200:
            raise self._ai_http_error('gemini', r)
        try:
            parts = r.json()['candidates'][0]['content']['parts']
        except (ValueError, KeyError, IndexError, TypeError):
            raise RuntimeError("gemini: empty or blocked response")
        text = "".join(p.get('text', '') for p in parts if not p.get('thought')).strip()
        if not text:
            raise RuntimeError("gemini: empty response")
        return text, model

    def _ai_groq(self, system, user):
        key = os.getenv('GROQ_API_KEY')
        headers = {'Authorization': f'Bearer {key}', 'Content-Type': 'application/json',
                   'User-Agent': self.AI_USER_AGENT}
        base = "https://api.groq.com/openai/v1"
        model = os.getenv('GROQ_MODEL')
        try:
            if not model:
                r = requests.get(f"{base}/models", headers=headers, timeout=15)
                if r.status_code != 200:
                    raise self._ai_http_error('groq', r)
                model = pick_groq_model([m.get('id') for m in r.json().get('data', [])
                                         if m.get('id')]) or 'llama-3.3-70b-versatile'
            payload = {'model': model, 'temperature': 0.2, 'max_tokens': 900,
                       'messages': [{'role': 'system', 'content': system},
                                    {'role': 'user', 'content': user}]}
            r = requests.post(f"{base}/chat/completions", headers=headers, json=payload, timeout=60)
        except (requests.RequestException, ValueError) as e:
            raise RuntimeError(f"groq: network/response error ({scrub_secrets(e)[:100]})")
        if r.status_code != 200:
            raise self._ai_http_error('groq', r)
        try:
            text = (r.json()['choices'][0]['message']['content'] or '').strip()
        except (ValueError, KeyError, IndexError, TypeError):
            raise RuntimeError("groq: empty or invalid response")
        if not text:
            raise RuntimeError("groq: empty response")
        return text, model

    def _ai_generate(self, user_prompt):
        """Ask the configured free provider(s); falls back to the next one on failure."""
        providers = self.ai_providers()
        if not providers:
            raise RuntimeError("no AI key configured - run: python3 setup_apis.py (free Gemini or Groq key)")
        errors = []
        for name in providers:
            try:
                text, model = (self._ai_gemini if name == 'gemini' else self._ai_groq)(
                    self.AI_SYSTEM, user_prompt)
                return text, name, model
            except RuntimeError as e:
                log.debug("AI provider failed: %s", e)
                errors.append(str(e))
        raise RuntimeError(" | ".join(errors))

    def _ai_report(self, title, user_prompt, sent):
        """Run the AI request, print the briefing and save it (with the exact data sent) to a file."""
        print(f"\n{M}[*]{W} {title} - asking the free AI provider (number and case details are NOT sent)...")
        try:
            text, provider, model = self._ai_generate(user_prompt)
        except RuntimeError as e:
            print(f"{R}[!]{W} AI briefing unavailable: {e}\n")
            return None
        print(f"\n{M}{title} ({provider}: {model}){W}")
        print("  AI-generated from non-identifying metadata - verify before relying on it.\n")
        for line in text.splitlines():
            print(f"  {line}")
        out_dir = self.cache_dir / "reports" / "ai"
        try:
            out_dir.mkdir(parents=True, exist_ok=True)
            path = out_dir / f"AI_{title.split()[1].capitalize()}_{datetime.now().strftime('%Y%m%d_%H%M%S')}.md"
            with open(path, 'w', encoding='utf-8') as f:
                f.write(f"# PhoneBookLOCA {title}\n\nGenerated: {datetime.now().isoformat()}\n"
                        f"Provider: {provider} ({model})\n\n"
                        "**AI-generated - verify before relying on it.** The phone number, case number, "
                        "officer, agency and file names were NOT sent to the provider.\n\n"
                        f"## Briefing\n\n{text}\n\n## Exact data sent to the provider\n\n"
                        f"```json\n{json.dumps(sent, indent=2)}\n```\n")
            print(f"\n{G}[+]{W} Saved: {path}\n")
        except OSError as e:
            print(f"\n{Y}[!]{W} Could not save the briefing: {e}\n")
        return text

    def ai_analyze(self, result):
        """AI briefing for one lookup result."""
        facts = self.ai_facts(result)
        prompt = ("Lookup metadata for ONE phone number (the number itself is withheld):\n"
                  + json.dumps(facts, indent=2)
                  + "\n\nWrite a briefing of at most 200 words covering: what the metadata indicates, "
                    "its reliability limits, and 2-4 lawful next steps.")
        return self._ai_report("AI Analysis", prompt, facts)

    def ai_briefing(self, rows, case_type, priority):
        """AI briefing for a whole LE list (items are numbered; no numbers or case ids are sent)."""
        facts = self.ai_facts_from_rows(rows, case_type, priority)
        prompt = (f"Lookup metadata for {len(rows)} phone numbers in ONE case (numbers withheld; items "
                  "are only numbered):\n" + json.dumps(facts, indent=2)
                  + "\n\nWrite a briefing of at most 300 words covering: overall patterns (shared carriers, "
                    "line types, geography, porting, breach exposure), items that stand out (refer to them "
                    "by item number), reliability limits, and 3-5 lawful next steps.")
        return self._ai_report("AI Briefing", prompt, facts)

    # ------------------------------------------------------------- LE mode

    def le_mode(self, ai=False):
        self.banner()
        print(f"{R}[LE] LAW ENFORCEMENT MODE{W}")
        print("Enhanced Geolocation for Investigations\n")

        case_num = input("Case Number: ").strip()
        officer = input("Officer Name: ").strip()
        agency = input("Agency: ").strip()
        case_type = input("Case Type (missing_person/trafficking/fraud/other) [other]: ").strip() or "other"
        priority = input("Priority (low/medium/high) [medium]: ").strip() or "medium"
        number = input("\nSubject Number: ").strip()

        if not all([case_num, officer, agency, number]):
            print(f"\n{R}[!]{W} All fields required\n")
            return

        try:
            c = self.db.conn.cursor()
            c.execute('''INSERT INTO le_cases (case_number, number, officer, agency, case_type, priority, created, status)
                         VALUES (?,?,?,?,?,?,?,?)''',
                      (case_num, number, officer, agency, case_type, priority,
                       datetime.now().isoformat(), 'active'))
            self.db.conn.commit()
            print(f"\n{G}[+]{W} Case created\n")
        except sqlite3.IntegrityError:
            print(f"\n{Y}[!]{W} Case number already exists\n")

        result = self.lookup(number, use_cache=False, enhanced=True, osint=True)
        if not result:
            return

        self._le_finalize(result, case_num, officer, agency, case_type, priority)

        print(f"\n{Y}[*]{W} Export format: 1) JSON  2) CSV  3) HTML  4) All  5) Skip")
        choice = input("Choice [1]: ").strip() or "1"
        self._le_export(result, case_num, choice)
        if ai:
            self.ai_analyze(result)

    # ----------------------------------------------- LE mode: number list

    def _le_finalize(self, result, case_num, officer, agency, case_type, priority):
        """Attach case info, recommendations and legal notice to an LE result."""
        result['case_info'] = {
            'case_number': case_num, 'officer': officer, 'agency': agency,
            'case_type': case_type, 'priority': priority,
            'generated': datetime.now().isoformat(),
        }
        result['recommendations'] = self.recommendations(result)
        result['legal_notice'] = 'Public data only - for real-time tracking or subscriber records, obtain a warrant/subpoena'
        if result['carrier'] in self.carrier_contacts:
            result['carrier_legal_contact'] = self.carrier_contacts[result['carrier']]

    def _le_export(self, result, case_num, choice):
        """Write the per-number LE report(s); returns the file paths written."""
        report_dir = self.cache_dir / "reports"
        report_dir.mkdir(parents=True, exist_ok=True)
        stem = report_dir / f"LE_Report_{case_num}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        written = []
        if choice in ("1", "4"):
            self._export_json(result, stem.with_suffix('.json'))
            written.append(stem.with_suffix('.json'))
        if choice in ("2", "4"):
            self._export_csv(result, stem.with_suffix('.csv'))
            written.append(stem.with_suffix('.csv'))
        if choice in ("3", "4"):
            self._export_html(result, stem.with_suffix('.html'))
            written.append(stem.with_suffix('.html'))
        return written

    @staticmethod
    def read_number_file(path):
        """Read one number per line; skips blank lines and '#' comments, drops duplicates."""
        numbers = []
        with open(path, encoding='utf-8-sig') as f:
            for line in f:
                num = line.strip()
                if num and not num.startswith('#') and num not in numbers:
                    numbers.append(num)
        return numbers

    @staticmethod
    def _breach_label(result):
        breach = (result.get('osint') or {}).get('breach') or {}
        if breach.get('breached'):
            return f"BREACHED ({breach['breach_count']})"
        statuses = [s['status'] for s in breach.get('sources', [])]
        if statuses and any(st == 'clean' for st in statuses):
            return "no breach found"
        return "not checked"

    def le_batch(self, numbers, ai=False):
        """LE mode over a list of numbers: case details asked ONCE, one case +
        full LE report set per number, then one summary table for the whole list."""
        self.banner()
        print(f"{R}[LE] LAW ENFORCEMENT MODE - NUMBER LIST ({len(numbers)} numbers){W}")
        print("Each number becomes its own case: <Case Number>-001, -002, ...\n")

        case_base = input("Case Number: ").strip()
        officer = input("Officer Name: ").strip()
        agency = input("Agency: ").strip()
        case_type = input("Case Type (missing_person/trafficking/fraud/other) [other]: ").strip() or "other"
        priority = input("Priority (low/medium/high) [medium]: ").strip() or "medium"
        if not all([case_base, officer, agency]) or not numbers:
            print(f"\n{R}[!]{W} Case number, officer, agency and at least one number are required\n")
            return

        print(f"\n{Y}[*]{W} Export format for every number: 1) JSON  2) CSV  3) HTML  4) All  5) Skip")
        choice = input("Choice [4]: ").strip() or "4"

        rows = []
        try:
            for i, number in enumerate(numbers, 1):
                case_id = f"{case_base}-{i:03d}"
                print(f"\n{C}{'=' * 60}{W}\n{C}[{i}/{len(numbers)}]{W} {number}  ->  case {case_id}")
                row = {'item': i, 'case_id': case_id, 'number': number, 'status': 'error',
                       'carrier': '', 'location': '', 'line_type': '', 'porting': '',
                       'geo_precision': '', 'breach': '', 'reports': ''}
                try:
                    try:
                        c = self.db.conn.cursor()
                        c.execute('''INSERT INTO le_cases (case_number, number, officer, agency, case_type, priority, created, status)
                                     VALUES (?,?,?,?,?,?,?,?)''',
                                  (case_id, number, officer, agency, case_type, priority,
                                   datetime.now().isoformat(), 'active'))
                        self.db.conn.commit()
                    except sqlite3.IntegrityError:
                        print(f"{Y}[!]{W} Case {case_id} already exists - continuing")

                    result = self.lookup(number, use_cache=False, enhanced=True, osint=True)
                    if not result:
                        row['status'] = 'invalid number'
                    else:
                        self._le_finalize(result, case_id, officer, agency, case_type, priority)
                        files = self._le_export(result, case_id, choice)
                        port = (result.get('enhanced') or {}).get('porting') or {}
                        breach = (result.get('osint') or {}).get('breach') or {}
                        row.update({
                            'status': 'ok',
                            'carrier': result.get('carrier', ''),
                            'location': result.get('location', ''),
                            'line_type': result.get('type', ''),
                            'porting': (f"likely ({port['confidence']}%)" if port.get('likely_ported')
                                        else 'unlikely') if port else '',
                            'geo_precision': (result.get('enhanced') or {}).get('precision', ''),
                            'breach': self._breach_label(result),
                            'reports': ' | '.join(Path(f).name for f in files + [Path(f) for f in breach.get('report_files', [])]),
                        })
                except Exception as e:  # noqa: BLE001 - one bad number must not stop the list
                    log.debug("LE batch item failed", exc_info=True)
                    row['status'] = f'error: {e}'
                    print(f"{R}[!]{W} {number}: {e}")
                rows.append(row)
        except KeyboardInterrupt:
            print(f"\n{Y}[!]{W} Interrupted - writing summary for the {len(rows)} number(s) done so far")

        self._le_summary(rows, case_base, officer, agency, case_type, priority, choice)
        if ai and rows:
            self.ai_briefing(rows, case_type, priority)

    def _le_summary(self, rows, case_base, officer, agency, case_type, priority, choice):
        """Print the end-of-run table and write the summary files."""
        if not rows:
            return
        ok = sum(1 for r in rows if r['status'] == 'ok')
        hits = sum(1 for r in rows if r['breach'].startswith('BREACHED'))

        print(f"\n{C}{'=' * 60}{W}\n{G}[+]{W} LE LIST SUMMARY - case {case_base}")
        print(f"  Numbers: {len(rows)}   Processed OK: {ok}   Breached: {hits}\n")
        header = f"  {'#':<3} {'Number':<16} {'Status':<15} {'Carrier':<18} {'Type':<13} {'Breach':<16}"
        print(header)
        print('  ' + '-' * (len(header) - 2))
        for r in rows:
            print(f"  {r['item']:<3} {r['number']:<16} {r['status'][:14]:<15} {r['carrier'][:17]:<18} "
                  f"{r['line_type'][:12]:<13} {r['breach']:<16}")

        report_dir = self.cache_dir / "reports"
        report_dir.mkdir(parents=True, exist_ok=True)
        stem = report_dir / f"LE_Summary_{case_base}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        fields = ['item', 'case_id', 'number', 'status', 'carrier', 'location', 'line_type',
                  'porting', 'geo_precision', 'breach', 'reports']
        saved = []
        try:
            with open(stem.with_suffix('.csv'), 'w', newline='', encoding='utf-8') as f:
                w = csv.DictWriter(f, fieldnames=fields)
                w.writeheader()
                w.writerows(rows)
            saved.append(stem.with_suffix('.csv'))

            esc = html.escape
            body = "".join(
                "<tr>" + "".join(f"<td>{esc(str(r[k]))}</td>" for k in fields) + "</tr>" for r in rows)
            head = "".join(f"<th>{esc(k)}</th>" for k in fields)
            page = f"""<!DOCTYPE html><html><head><meta charset="utf-8">
<title>PhoneBookLOCA LE Summary - {esc(case_base)}</title>
<style>body{{font-family:'Courier New',monospace;background:#0a0014;color:#7ef9ff;padding:2em}}
h1{{color:#ff00e6}}table{{border-collapse:collapse;width:100%}}th,td{{border:1px solid #00f0ff55;padding:6px 10px;text-align:left;font-size:13px}}
th{{color:#ff6bf0}}</style></head><body>
<h1>PhoneBookLOCA :: LE Summary - {esc(case_base)}</h1>
<p>Officer: {esc(officer)} | Agency: {esc(agency)} | Type: {esc(case_type)} | Priority: {esc(priority)}<br>
Generated: {esc(datetime.now().isoformat())} | Numbers: {len(rows)} | Processed OK: {ok} | Breached: {hits}</p>
<table><tr>{head}</tr>{body}</table>
<p><em>Public data only - for real-time tracking or subscriber records, obtain a warrant/subpoena.
Breach presence shows a number appeared in leaked data; it does not by itself identify its user.</em></p>
</body></html>"""
            with open(stem.with_suffix('.html'), 'w', encoding='utf-8') as f:
                f.write(page)
            saved.append(stem.with_suffix('.html'))

            if choice in ("1", "4"):
                with open(stem.with_suffix('.json'), 'w', encoding='utf-8') as f:
                    json.dump({'case': case_base, 'officer': officer, 'agency': agency,
                               'case_type': case_type, 'priority': priority,
                               'generated': datetime.now().isoformat(), 'numbers': rows}, f, indent=2)
                saved.append(stem.with_suffix('.json'))
        except OSError as e:
            print(f"{R}[!]{W} Could not write summary: {e}")
        for f in saved:
            print(f"{G}[+]{W} Summary saved: {f}")
        print()

    def _export_json(self, report, path):
        with open(path, 'w', encoding='utf-8') as f:
            json.dump(report, f, indent=2)
        print(f"{G}[+]{W} JSON report saved: {path}")

    def _export_csv(self, report, path):
        flat = {
            'number': report.get('number'), 'country_code': report.get('country_code'),
            'location': report.get('location'), 'carrier': report.get('carrier'),
            'type': report.get('type'), 'case_number': report.get('case_info', {}).get('case_number'),
            'officer': report.get('case_info', {}).get('officer'),
            'agency': report.get('case_info', {}).get('agency'),
        }
        with open(path, 'w', newline='', encoding='utf-8') as f:
            writer = csv.DictWriter(f, fieldnames=list(flat.keys()))
            writer.writeheader()
            writer.writerow(flat)
        print(f"{G}[+]{W} CSV report saved: {path}")

    def _export_html(self, report, path):
        rows = "".join(f"<tr><th>{k}</th><td>{v}</td></tr>" for k, v in report.items()
                        if not isinstance(v, (dict, list)))
        recs = "".join(f"<li>{r}</li>" for r in report.get('recommendations', []))
        html = f"""<!DOCTYPE html><html><head><meta charset="utf-8">
<title>PhoneBookLOCA Report - {report.get('number')}</title>
<style>body{{font-family:monospace;background:#0d0d0d;color:#0ff;padding:2em}}
table{{border-collapse:collapse}}th,td{{border:1px solid #0ff3;padding:6px 12px;text-align:left}}
h1{{color:#f0f}}</style></head><body>
<h1>PhoneBookLOCA Investigation Report</h1>
<table>{rows}</table>
<h2>Recommendations</h2><ul>{recs}</ul>
<p><em>{report.get('legal_notice', '')}</em></p>
</body></html>"""
        with open(path, 'w', encoding='utf-8') as f:
            f.write(html)
        print(f"{G}[+]{W} HTML report saved: {path}")

    # --------------------------------------------------------- interactive

    def interactive(self):
        self.banner()
        print("Commands: <number> | geo <number> | osint <number> | ai <number> | batch <file> | le-mode [--batch <file>] | help | quit\n")

        while True:
            try:
                cmd = input(f"{C}PhoneBook>{W} ").strip()
                low = cmd.lower()

                if low in ('quit', 'exit', 'q'):
                    print("\nGoodbye!\n")
                    break
                if low == 'help':
                    self.show_help()
                    continue
                if low == 'le-mode':
                    self.le_mode()
                    continue
                if low.startswith('le-mode '):
                    # "le-mode --batch FILE" or "le-mode FILE": LE mode over a number list
                    arg = cmd[8:].strip()
                    if arg.lower().startswith('--batch'):
                        arg = arg[7:].strip()
                    arg = os.path.expanduser(arg.strip('\'"'))
                    if not arg:
                        print(f"{Y}[!]{W} Usage: le-mode --batch <file>\n")
                        continue
                    try:
                        nums = self.read_number_file(resolve_number_file(arg))
                    except OSError as e:
                        print(f"{R}[!]{W} Error: {e}\n")
                        continue
                    self.le_batch(nums)
                    continue
                if low.startswith('geo '):
                    self.lookup(cmd[4:].strip(), enhanced=True)
                    continue
                if low.startswith('ai '):
                    result = self.lookup(cmd[3:].strip(), use_cache=False, enhanced=True, osint=True)
                    if result:
                        self.ai_analyze(result)
                    continue
                if low.startswith('osint '):
                    self.lookup(cmd[6:].strip(), enhanced=True, osint=True)
                    continue
                if low.startswith('batch '):
                    file = cmd[6:].strip()
                    try:
                        with open(resolve_number_file(file), encoding='utf-8') as f:
                            nums = [line.strip() for line in f if line.strip()]
                        self.batch(nums)
                    except OSError as e:
                        print(f"{R}[!]{W} Error: {e}\n")
                    continue
                if cmd:
                    self.lookup(cmd)
            except KeyboardInterrupt:
                print("\n\nExiting...\n")
                break

    def show_help(self):
        print(f"""
Commands:
  <number>         - Standard lookup
  geo <number>     - Enhanced geolocation + porting + history
  osint <number>   - Passive OSINT leads (dorks, lookup URLs, optional Go scraper)
  ai <number>      - Full lookup + AI briefing (free Gemini/Groq key; the number is never sent)
  batch <file>     - Analyze multiple numbers, saves a risk-scored JSON report
  le-mode          - Law enforcement case mode (JSON/CSV/HTML export)
                     le-mode --batch <file> runs it on a whole list of numbers
  help             - Show this
  quit             - Exit

v{VERSION} additions:
  - Confidence-scored porting detection and geolocation precision
  - Risk-scored batch reports saved to disk automatically
  - Passive OSINT lead generation (+ optional compiled Go scraper)
  - Historical carrier/location tracking surfaced in reports
  - CSV/HTML export alongside JSON for LE reports
  - Cross-platform: Windows, macOS, Linux
  - OSINT breach check - works with no API: drop breach files in
    ~/.phonebookloca/breach_data/ to search them offline. Breach reports are saved
    under ~/.phonebookloca/reports/breach/
  - AI briefings (--ai / ai <number>) using a FREE Gemini or Groq key. Run
    python3 setup_apis.py to get the exact links and set the keys up automatically.
""")


def build_arg_parser():
    parser = argparse.ArgumentParser(
        description=f'PhoneBookLOCA v{VERSION} - Worldwide OSINT Platform'
    )
    parser.add_argument('number', nargs='?', help='Phone number in E.164 format, e.g. +14155552671')
    parser.add_argument('--geo', action='store_true', help='Enhanced geolocation, porting and history')
    parser.add_argument('--osint', action='store_true', help='Passive OSINT lead generation')
    parser.add_argument('--le-mode', action='store_true', help='Law enforcement case mode')
    parser.add_argument('--batch', metavar='FILE',
                        help='Batch-analyze numbers from a file (one per line); with --le-mode, runs LE mode on every number')
    parser.add_argument('--no-cache', action='store_true', help='Skip the local cache')
    parser.add_argument('--ai', action='store_true',
                        help='Add an AI-written briefing (free Gemini/Groq key via setup_apis.py; the number is never sent). Implies --geo --osint')
    parser.add_argument('--output', '-o', metavar='FILE', help='Save the result/report to this path')
    parser.add_argument('--verbose', '-v', action='store_true', help='Verbose diagnostic logging')
    parser.add_argument('--version', action='version', version=f'PhoneBookLOCA v{VERSION}')
    return parser


def main():
    parser = build_arg_parser()
    args = parser.parse_args()

    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.WARNING,
        format='%(levelname)s: %(message)s',
    )

    intel = PhoneIntel()

    if args.le_mode:
        if args.batch:
            try:
                nums = intel.read_number_file(resolve_number_file(args.batch))
            except OSError as e:
                print(f"Error: {e}")
                sys.exit(1)
            intel.le_batch(nums, ai=args.ai)
        else:
            intel.le_mode(ai=args.ai)
        return

    if args.batch:
        try:
            with open(resolve_number_file(args.batch), encoding='utf-8') as f:
                nums = [line.strip() for line in f if line.strip()]
        except OSError as e:
            print(f"Error: {e}")
            sys.exit(1)
        intel.banner()
        intel.batch(nums, output=args.output)
        if args.ai:
            print(f"{Y}[i]{W} --ai works with a single number or with --le-mode --batch FILE\n")
        return

    if args.number:
        intel.banner()
        result = intel.lookup(args.number, use_cache=not args.no_cache,
                               enhanced=args.geo or args.ai, osint=args.osint or args.ai)
        if result and args.output:
            try:
                with open(args.output, 'w', encoding='utf-8') as f:
                    json.dump(result, f, indent=2)
                print(f"{G}[+]{W} Saved to {args.output}\n")
            except OSError as e:
                print(f"{R}[!]{W} Could not write {args.output}: {e}\n")
        if result and args.ai:
            intel.ai_analyze(result)
        return

    intel.interactive()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\nExiting...\n")
    except Exception as e:  # noqa: BLE001 - top-level guard so the tool never hard-crashes
        log.debug("Unhandled exception", exc_info=True)
        print(f"\n{R}[!] Fatal error:{W} {e}")
        print("Run with --verbose for a full traceback.\n")
        sys.exit(1)
