def config_path():
    """File where setup_apis.py stores the free API keys."""
    return Path.home() / ".phonebookloca" / "config.json"


def load_config():
    """Load API keys saved by setup_apis.py into the environment.
    Real environment variables always win over the saved file."""
    try:
        with open(config_path(), encoding='utf-8') as f:
            cfg = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as e:
        log.warning("Could not read %s: %s", config_path(), e)
        return {}
    if not isinstance(cfg, dict):
        return {}
    for k, v in cfg.items():
        if isinstance(v, str) and v and k not in os.environ:
            os.environ[k] = v
    return cfg


def scrub_secrets(text):
    """Hide API keys/tokens that appear in URLs inside error messages."""
    return re.sub(r'(?i)\b(key|token)=[^&\s\'")]+', r'\1=***', str(text))


def pick_gemini_model(models):
    """Choose the newest stable Gemini Flash model that supports generateContent.
    Prefers stable names over '-preview' ones and plain Flash over Flash-Lite."""
    best = None
    for m in models or []:
        name = (m.get('name') or '').replace('models/', '')
        if 'generateContent' not in (m.get('supportedGenerationMethods') or []):
            continue
        mt = re.fullmatch(r'gemini-(\d+(?:\.\d+)?)-flash(-lite)?(-preview(?:-[\w.-]+)?)?', name)
        if not mt:
            continue
        score = (0 if mt.group(3) else 1, float(mt.group(1)), 0 if mt.group(2) else 1)
        if best is None or score > best[0]:
            best = (score, name)
    return best[1] if best else None


def pick_groq_model(ids):
    """Choose a general chat model from Groq's model list."""
    ids = list(ids or [])
    for want in ('llama-3.3-70b-versatile', 'llama-3.1-8b-instant',
                 'openai/gpt-oss-20b', 'openai/gpt-oss-120b'):
        if want in ids:
            return want
    skip = re.compile(r'whisper|guard|tts|playai|embed|distil|safeguard|orpheus', re.I)
    for i in ids:
        if not skip.search(i):
            return i
    return None


def data_file(name):
    """Locate a bundled data file, whether run from source or an installed copy."""
    candidates = [
        APP_DIR / "data" / name,
        Path(sys.prefix) / "share" / "phonebookloca" / name,
        Path("/usr/local/share/phonebookloca") / name,
        Path("/usr/share/phonebookloca") / name,
        Path.home() / ".phonebookloca" / "data" / name,
    ]
    for c in candidates:
        if c.exists():
            return c
    return None


def find_list_file(name):
    """Locate a numbers file from just its name.

    Search order (first folder with a match wins, not recursive): current folder,
    the script's folder, home, ~/Documents, ~/Desktop, ~/Downloads, ~/.phonebookloca.
    A name without an extension also tries '<name>.txt'. Absolute paths and ~/paths
    are used as given. Returns (matches, folders_searched).
    """
    raw = os.path.expanduser(str(name).strip().strip('\'"'))
    names = [raw] + ([raw + '.txt'] if not Path(raw).suffix else [])
    home = Path.home()
    folders = []
    for d in (Path.cwd(), APP_DIR, home, home / 'Documents', home / 'Desktop',
              home / 'Downloads', home / '.phonebookloca'):
        if d not in folders:
            folders.append(d)

    for nm in names:                      # an exact-name match beats the '.txt' fallback
        candidates = [Path(nm)] if Path(nm).is_absolute() else [d / nm for d in folders]
        matches, seen = [], set()
        for c in candidates:
            try:
                if c.is_file() and c.resolve() not in seen:
                    seen.add(c.resolve())
                    matches.append(c)
            except OSError:
                continue
        if matches:
            return matches, folders
    return [], folders


def resolve_number_file(name):
    """Return the path of a numbers file given only its name (see find_list_file).
    Prints which file is used when it was not found at the literal path, and warns
    if the same name exists in several folders. Raises FileNotFoundError if missing."""
    matches, folders = find_list_file(name)
    if not matches:
        where = ", ".join(str(f) for f in folders)
        raise FileNotFoundError(f"'{name}' not found. Looked in: {where}")
    chosen = matches[0]
    if str(chosen) != str(name) and chosen.resolve() != Path(os.path.expanduser(str(name))).resolve():
        print(f"{Y}[i]{W} Using {chosen}")
    if len(matches) > 1:
        others = ", ".join(str(m) for m in matches[1:])
        print(f"{Y}[!]{W} Same file name also found in: {others} - using the first one above")
    return str(chosen)


def haversine_km(lat1, lon1, lat2, lon2):
    """Great-circle distance between two points, in kilometers."""
    r = 6371.0
    p1, p2 = math.radians(lat1), math.radians(lat2)
    dphi = math.radians(lat2 - lat1)
    dlambda = math.radians(lon2 - lon1)
    a = math.sin(dphi / 2) ** 2 + math.cos(p1) * math.cos(p2) * math.sin(dlambda / 2) ** 2
    return 2 * r * math.asin(math.sqrt(a))


class Database:
    """SQLite-backed cache, worldwide area-code table, LE case tracking and history."""

    def __init__(self, db_path):
        self.conn = sqlite3.connect(str(db_path))
        self.conn.row_factory = sqlite3.Row
        self.setup()

    def setup(self):
        c = self.conn.cursor()

        c.execute('''CREATE TABLE IF NOT EXISTS lookups (
            number TEXT PRIMARY KEY,
            data TEXT,
            timestamp TEXT,
            lookup_count INTEGER DEFAULT 1
        )''')

        c.execute('''CREATE TABLE IF NOT EXISTS area_codes (
            country_code TEXT,
            area_code TEXT,
            city TEXT,
            region TEXT,
            country TEXT,
            lat REAL,
            lon REAL,
            timezone TEXT,
            PRIMARY KEY (country_code, area_code)
        )''')

        c.execute('''CREATE TABLE IF NOT EXISTS le_cases (
            id INTEGER PRIMARY KEY,
            case_number TEXT UNIQUE,
            number TEXT,
            officer TEXT,
            agency TEXT,
            case_type TEXT,
            priority TEXT,
            created TEXT,
            status TEXT
        )''')

        c.execute('''CREATE TABLE IF NOT EXISTS history (
            id INTEGER PRIMARY KEY,
            number TEXT,
            timestamp TEXT,
            carrier TEXT,
            location TEXT
        )''')

        self.conn.commit()
        self._migrate_legacy_schema()
        self.load_worldwide()

    def _migrate_legacy_schema(self):
        """Add columns introduced after v2.2 if the DB pre-dates them."""
        c = self.conn.cursor()
        cols = {row['name'] for row in c.execute('PRAGMA table_info(area_codes)')}
        if 'region' not in cols:
            c.execute('ALTER TABLE area_codes ADD COLUMN region TEXT')
        cols = {row['name'] for row in c.execute('PRAGMA table_info(le_cases)')}
        for col in ('case_type', 'priority'):
            if col not in cols:
                c.execute(f'ALTER TABLE le_cases ADD COLUMN {col} TEXT')
        self.conn.commit()

    def load_worldwide(self):
        """Load the worldwide area-code database from data/area_codes.json."""
        c = self.conn.cursor()
        c.execute('SELECT COUNT(*) as cnt FROM area_codes')
        if c.fetchone()['cnt'] > 0:
            return

        path = data_file("area_codes.json")
        codes = []
        if path:
            try:
                with open(path, encoding='utf-8') as f:
                    codes = json.load(f).get('codes', [])
            except (OSError, json.JSONDecodeError) as e:
                log.warning("Could not load area_codes.json: %s", e)

        if not codes:
            # Minimal built-in fallback so the tool still works with zero data files.
            codes = [
                ['1', '415', 'San Francisco', 'California', 'United States', 37.7749, -122.4194, 'America/Los_Angeles'],
                ['44', '20', 'London', 'Greater London', 'United Kingdom', 51.5074, -0.1278, 'Europe/London'],
                ['27', '11', 'Johannesburg', 'Gauteng', 'South Africa', -26.2041, 28.0473, 'Africa/Johannesburg'],
            ]

        rows = [(cc, ac, city, region, country, lat, lon, tz)
                for cc, ac, city, region, country, lat, lon, tz in codes]
        c.executemany(
            'INSERT OR IGNORE INTO area_codes VALUES (?,?,?,?,?,?,?,?)', rows
        )
        self.conn.commit()

    def cache_get(self, number):
        c = self.conn.cursor()
        c.execute('SELECT * FROM lookups WHERE number = ?', (number,))
        row = c.fetchone()
        return json.loads(row['data']) if row else None

    def cache_set(self, number, data):
        c = self.conn.cursor()
        c.execute('''INSERT INTO lookups (number, data, timestamp, lookup_count)
                     VALUES (?, ?, ?, 1)
                     ON CONFLICT(number) DO UPDATE SET
                        data=excluded.data,
                        timestamp=excluded.timestamp,
                        lookup_count=lookup_count + 1''',
                  (number, json.dumps(data), datetime.now().isoformat()))
        self.conn.commit()

    def history_add(self, number, carrier_name, location):
        c = self.conn.cursor()
        c.execute('INSERT INTO history (number, timestamp, carrier, location) VALUES (?,?,?,?)',
                  (number, datetime.now().isoformat(), carrier_name, location))
        self.conn.commit()

    def history_for(self, number):
        """Aggregate historical tracking data for a number."""
        c = self.conn.cursor()
        c.execute('SELECT * FROM history WHERE number = ? ORDER BY timestamp', (number,))
        rows = c.fetchall()
        if not rows:
            return None

        carriers_seen = list(dict.fromkeys(r['carrier'] for r in rows if r['carrier']))
        c.execute('SELECT DISTINCT agency FROM le_cases WHERE number = ? AND agency IS NOT NULL', (number,))
        agencies = [r['agency'] for r in c.fetchall()]

        return {
            'first_seen': rows[0]['timestamp'],
            'last_seen': rows[-1]['timestamp'],
            'total_lookups': len(rows),
            'carriers_seen': carriers_seen,
            'carrier_changed': len(carriers_seen) > 1,
            'agencies': agencies,
        }

    def get_area_code(self, country_code, area_code):
        c = self.conn.cursor()
        c.execute('SELECT * FROM area_codes WHERE country_code=? AND area_code=?',
                  (country_code, area_code))
        return c.fetchone()


